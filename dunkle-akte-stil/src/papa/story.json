{
 "title": "Papa ist nicht Papa",
 "voice": "de-DE-ChristophNeural",
 "rate": "+5%",
 "pitch": "-5Hz",
 "lead_in": 0.25,
 "lines": [
  {
   "text": "Es ist drei Uhr nachts.",
   "chunks": [
    "ES IST *DREI*",
    "UHR NACHTS."
   ],
   "gap_after": 0.32,
   "tag": "hook"
  },
  {
   "text": "Draußen mäht jemand den Rasen.",
   "chunks": [
    "DRAUSSEN MÄHT JEMAND",
    "DEN *RASEN.*"
   ],
   "gap_after": 0.32,
   "tag": "hook"
  },
  {
   "text": "Du schaust aus dem Fenster.",
   "chunks": [
    "DU SCHAUST AUS",
    "DEM FENSTER."
   ],
   "gap_after": 0.32,
   "tag": "hook"
  },
  {
   "text": "Es ist Papa.",
   "chunks": [
    "ES IST *PAPA.*"
   ],
   "gap_after": 0.32,
   "tag": "hook"
  },
  {
   "text": "Er trägt seine Grillschürze. Und Socken in Sandalen.",
   "chunks": [
    "ER TRÄGT",
    "SEINE GRILLSCHÜRZE.",
    "UND SOCKEN",
    "IN SANDALEN."
   ],
   "gap_after": 0.32,
   "tag": "hook"
  },
  {
   "text": "Er winkt dir zu.",
   "chunks": [
    "ER WINKT",
    "DIR ZU."
   ],
   "gap_after": 0.32,
   "tag": "hook"
  },
  {
   "text": "Aber Papa ist auf Montage.",
   "chunks": [
    "ABER PAPA IST",
    "AUF *MONTAGE.*"
   ],
   "gap_after": 0.32,
   "tag": "hook"
  },
  {
   "text": "In Hamburg. Seit Montag.",
   "chunks": [
    "IN *HAMBURG.*",
    "SEIT MONTAG."
   ],
   "gap_after": 0.7,
   "tag": "hook"
  },
  {
   "text": "Dein Handy vibriert.",
   "chunks": [
    "DEIN HANDY *VIBRIERT.*"
   ],
   "gap_after": 0.32,
   "tag": "phone1"
  },
  {
   "text": "Eine Nachricht. Von Papa.",
   "chunks": [
    "EINE NACHRICHT.",
    "VON PAPA."
   ],
   "gap_after": 0.32,
   "tag": "phone1"
  },
  {
   "text": "Kann nicht schlafen. Alles gut bei euch?",
   "chunks": [
    "„KANN NICHT *SCHLAFEN.*",
    "ALLES GUT",
    "BEI EUCH?“"
   ],
   "gap_after": 0.32,
   "tag": "msg1",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "+0%",
   "pitch": "-4Hz",
   "speaker": "papa"
  },
  {
   "text": "Du tippst: „Du mähst doch gerade den Rasen.“",
   "chunks": [
    "DU TIPPST:",
    "„DU MÄHST DOCH",
    "GERADE DEN RASEN.“"
   ],
   "gap_after": 0.32,
   "tag": "phone1"
  },
  {
   "text": "Drei Punkte. Sie verschwinden. Sie kommen wieder.",
   "chunks": [
    "DREI PUNKTE.",
    "SIE *VERSCHWINDEN.*",
    "SIE KOMMEN WIEDER."
   ],
   "gap_after": 0.32,
   "tag": "phone1"
  },
  {
   "text": "Unser Rasenmäher ist seit Sommer kaputt.",
   "chunks": [
    "„UNSER RASENMÄHER IST",
    "SEIT SOMMER *KAPUTT.*“"
   ],
   "gap_after": 0.32,
   "tag": "msg2",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "+0%",
   "pitch": "-4Hz",
   "speaker": "papa"
  },
  {
   "text": "Mach nicht die Tür auf.",
   "chunks": [
    "„MACH *NICHT* DIE",
    "TÜR AUF.“"
   ],
   "gap_after": 0.32,
   "tag": "msg2",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "+0%",
   "pitch": "-4Hz",
   "speaker": "papa"
  },
  {
   "text": "Frag ihn, wie unser Hund hieß.",
   "chunks": [
    "„FRAG IHN, WIE",
    "UNSER *HUND* HIESS.“"
   ],
   "gap_after": 0.7,
   "tag": "msg2",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "+0%",
   "pitch": "-4Hz",
   "speaker": "papa"
  },
  {
   "text": "Der Rasenmäher geht aus.",
   "chunks": [
    "DER RASENMÄHER",
    "GEHT *AUS.*"
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Stille.",
   "chunks": [
    "STILLE."
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Du öffnest das Fenster einen Spalt.",
   "chunks": [
    "DU ÖFFNEST DAS",
    "FENSTER EINEN *SPALT.*"
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "„Papa? Wie hieß unser Hund?“",
   "chunks": [
    "„PAPA?",
    "WIE HIESS",
    "UNSER HUND?“"
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Er lacht. Genau wie Papa. Erst über sich selbst.",
   "chunks": [
    "ER LACHT.",
    "GENAU WIE PAPA.",
    "ERST *ÜBER*",
    "SICH SELBST."
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Keks, Kumpel. Er hieß Keks.",
   "chunks": [
    "„*KEKS,* KUMPEL.",
    "ER HIESS KEKS.“"
   ],
   "gap_after": 0.32,
   "tag": "test1",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Das stimmt.",
   "chunks": [
    "DAS *STIMMT.*"
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Dann dreht er sich um.",
   "chunks": [
    "DANN DREHT ER",
    "SICH UM."
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Und sein Hals wächst.",
   "chunks": [
    "UND SEIN",
    "HALS *WÄCHST.*"
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Über die Hecke. Über den Zaun.",
   "chunks": [
    "ÜBER DIE HECKE.",
    "ÜBER DEN ZAUN."
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Bis sein Kopf vor dem Fenster im ersten Stock hängt.",
   "chunks": [
    "BIS SEIN KOPF",
    "VOR DEM FENSTER",
    "IM ERSTEN",
    "*STOCK* HÄNGT."
   ],
   "gap_after": 0.32,
   "tag": "test"
  },
  {
   "text": "Machst du Papa auf, Kumpel?",
   "chunks": [
    "„MACHST DU PAPA",
    "*AUF,* KUMPEL?“"
   ],
   "gap_after": 0.7,
   "tag": "test1",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Du knallst das Fenster zu.",
   "chunks": [
    "DU KNALLST DAS",
    "FENSTER *ZU.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Du rennst zu Lea. Deine kleine Schwester.",
   "chunks": [
    "DU RENNST",
    "ZU LEA.",
    "DEINE KLEINE *SCHWESTER.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Sie schläft. Du hältst ihr den Mund zu.",
   "chunks": [
    "SIE SCHLÄFT.",
    "DU HÄLTST IHR",
    "DEN *MUND* ZU."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Unten geht der Fernseher an.",
   "chunks": [
    "UNTEN GEHT DER",
    "*FERNSEHER* AN."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Ihr schleicht zur Treppe.",
   "chunks": [
    "IHR SCHLEICHT",
    "ZUR TREPPE."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Auf dem Sofa liegt jemand. Fernbedienung in der Hand.",
   "chunks": [
    "AUF DEM SOFA",
    "LIEGT JEMAND.",
    "FERNBEDIENUNG IN",
    "DER HAND."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Er schnarcht.",
   "chunks": [
    "ER *SCHNARCHT.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Es ist Papa. Wieder.",
   "chunks": [
    "ES IST PAPA.",
    "*WIEDER.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Das Schnarchen hört auf.",
   "chunks": [
    "DAS SCHNARCHEN",
    "HÖRT *AUF.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Ich schlafe nicht. Ich ruhe nur die Augen aus.",
   "chunks": [
    "„ICH SCHLAFE NICHT.",
    "ICH RUHE NUR",
    "DIE *AUGEN* AUS.“"
   ],
   "gap_after": 0.32,
   "tag": "sofa",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Seine Augen gehen auf. Sie sind schwarz.",
   "chunks": [
    "SEINE AUGEN",
    "GEHEN AUF.",
    "SIE SIND *SCHWARZ.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Ganz schwarz.",
   "chunks": [
    "GANZ SCHWARZ."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Ihr rennt in die Abstellkammer.",
   "chunks": [
    "IHR RENNT IN",
    "DIE *ABSTELLKAMMER.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Du schließt ab. Ihr atmet nicht.",
   "chunks": [
    "DU SCHLIESST AB.",
    "IHR ATMET *NICHT.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Schritte im Flur. Langsam.",
   "chunks": [
    "SCHRITTE IM FLUR.",
    "LANGSAM."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Dann nichts mehr.",
   "chunks": [
    "DANN NICHTS MEHR."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Dann eine Stimme. Direkt vor der Tür.",
   "chunks": [
    "DANN EINE STIMME.",
    "DIREKT VOR",
    "DER TÜR."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Ich zähle bis drei.",
   "chunks": [
    "„ICH ZÄHLE",
    "BIS *DREI.*“"
   ],
   "gap_after": 0.32,
   "tag": "count",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Eins.",
   "chunks": [
    "„EINS.“"
   ],
   "gap_after": 0.32,
   "tag": "count",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Zwei.",
   "chunks": [
    "„ZWEI.“"
   ],
   "gap_after": 0.32,
   "tag": "count",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Zweieinhalb.",
   "chunks": [
    "„ZWEIEINHALB.“"
   ],
   "gap_after": 0.32,
   "tag": "count",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Genau wie Papa. Er kommt nie bis drei.",
   "chunks": [
    "GENAU WIE PAPA.",
    "ER KOMMT NIE",
    "BIS *DREI.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Die Klinke bewegt sich. Ganz langsam.",
   "chunks": [
    "DIE KLINKE",
    "BEWEGT SICH.",
    "GANZ *LANGSAM.*"
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Dann lässt sie los.",
   "chunks": [
    "DANN LÄSST",
    "SIE LOS."
   ],
   "gap_after": 0.32,
   "tag": "flight"
  },
  {
   "text": "Lea zittert. Du hältst sie fest.",
   "chunks": [
    "LEA ZITTERT.",
    "DU HÄLTST",
    "SIE FEST."
   ],
   "gap_after": 0.7,
   "tag": "flight"
  },
  {
   "text": "Dein Handy leuchtet. Eine Sprachnachricht.",
   "chunks": [
    "DEIN HANDY LEUCHTET.",
    "EINE *SPRACHNACHRICHT.*"
   ],
   "gap_after": 0.32,
   "tag": "voice"
  },
  {
   "text": "Hör mir zu. Ich sitze im Auto. Ich komme.",
   "chunks": [
    "„HÖR MIR ZU.",
    "ICH SITZE",
    "IM *AUTO.*",
    "ICH KOMME.“"
   ],
   "gap_after": 0.32,
   "tag": "voicemsg",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "+0%",
   "pitch": "-4Hz",
   "speaker": "papa"
  },
  {
   "text": "Aber im Hintergrund hörst du etwas.",
   "chunks": [
    "ABER IM HINTERGRUND",
    "HÖRST DU ETWAS."
   ],
   "gap_after": 0.32,
   "tag": "voice"
  },
  {
   "text": "Einen Rasenmäher.",
   "chunks": [
    "EINEN *RASENMÄHER.*"
   ],
   "gap_after": 0.32,
   "tag": "voice"
  },
  {
   "text": "Wer schreibt dir da wirklich?",
   "chunks": [
    "WER SCHREIBT DIR",
    "DA WIRKLICH?"
   ],
   "gap_after": 0.32,
   "tag": "voice"
  },
  {
   "text": "Du schreibst zurück: „Beweis, dass du es bist.“",
   "chunks": [
    "DU SCHREIBST ZURÜCK:",
    "„BEWEIS, DASS DU",
    "ES BIST.“"
   ],
   "gap_after": 0.32,
   "tag": "voice"
  },
  {
   "text": "Du hast Angst vor dem Keller. Seit du vier bist.",
   "chunks": [
    "„DU HAST ANGST",
    "VOR DEM *KELLER.*",
    "SEIT DU",
    "VIER BIST.“"
   ],
   "gap_after": 0.32,
   "tag": "msg3",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "+0%",
   "pitch": "-4Hz",
   "speaker": "papa"
  },
  {
   "text": "Das weiß niemand.",
   "chunks": [
    "DAS WEISS *NIEMAND.*"
   ],
   "gap_after": 0.32,
   "tag": "voice"
  },
  {
   "text": "Außer Papa.",
   "chunks": [
    "AUSSER PAPA."
   ],
   "gap_after": 0.32,
   "tag": "voice"
  },
  {
   "text": "Oder etwas, das ihn sehr lange beobachtet hat.",
   "chunks": [
    "ODER ETWAS, DAS",
    "IHN SEHR LANGE",
    "*BEOBACHTET* HAT."
   ],
   "gap_after": 0.7,
   "tag": "voice"
  },
  {
   "text": "Lea zieht an deinem Ärmel.",
   "chunks": [
    "LEA ZIEHT AN",
    "DEINEM ÄRMEL."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Papa hat gesagt, ich soll aufmachen.",
   "chunks": [
    "„PAPA HAT GESAGT,",
    "ICH SOLL *AUFMACHEN.*“"
   ],
   "gap_after": 0.32,
   "tag": "betrayl",
   "quote": true,
   "voice": "de-DE-TanjaNeural",
   "rate": "+4%",
   "pitch": "+38Hz",
   "speaker": "lea"
  },
  {
   "text": "Bevor du sie halten kannst, dreht sie den Schlüssel.",
   "chunks": [
    "BEVOR DU SIE",
    "HALTEN KANNST, DREHT",
    "SIE DEN *SCHLÜSSEL.*"
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Die Tür geht auf.",
   "chunks": [
    "DIE TÜR",
    "GEHT AUF."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "In der Küche brennt Licht.",
   "chunks": [
    "IN DER KÜCHE",
    "BRENNT LICHT."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Am Tisch sitzt der dritte Papa.",
   "chunks": [
    "AM TISCH SITZT",
    "DER *DRITTE* PAPA."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Er liest Zeitung. Kopfüber.",
   "chunks": [
    "ER LIEST ZEITUNG.",
    "*KOPFÜBER.*"
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Neben ihm blubbert die Kaffeemaschine.",
   "chunks": [
    "NEBEN IHM BLUBBERT",
    "DIE KAFFEEMASCHINE."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Er schaut nicht auf.",
   "chunks": [
    "ER SCHAUT",
    "NICHT AUF."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Wer hat im Flur das Licht angelassen?",
   "chunks": [
    "„WER HAT IM",
    "FLUR DAS",
    "LICHT *ANGELASSEN?*“"
   ],
   "gap_after": 0.32,
   "tag": "kitchen",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Strom kostet Geld, Kumpel.",
   "chunks": [
    "„STROM KOSTET",
    "*GELD,* KUMPEL.“"
   ],
   "gap_after": 0.32,
   "tag": "kitchen",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Deine Stimme zittert. „Wo ist Mama?“",
   "chunks": [
    "DEINE STIMME ZITTERT.",
    "„WO IST *MAMA?*“"
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Er blättert um.",
   "chunks": [
    "ER BLÄTTERT UM."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Frag deine Mutter.",
   "chunks": [
    "„FRAG DEINE *MUTTER.*“"
   ],
   "gap_after": 0.32,
   "tag": "kitchen",
   "quote": true,
   "voice": "de-AT-JonasNeural",
   "rate": "-14%",
   "pitch": "-20Hz",
   "speaker": "monster"
  },
  {
   "text": "Das sagt Papa immer.",
   "chunks": [
    "DAS SAGT",
    "PAPA IMMER."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Aber Mama ist bei Oma. Seit drei Tagen.",
   "chunks": [
    "ABER MAMA IST",
    "BEI OMA.",
    "SEIT *DREI* TAGEN."
   ],
   "gap_after": 0.32,
   "tag": "betray"
  },
  {
   "text": "Das Licht geht aus.",
   "chunks": [
    "DAS LICHT",
    "GEHT *AUS.*"
   ],
   "gap_after": 0.7,
   "tag": "betray"
  },
  {
   "text": "Stromausfall.",
   "chunks": [
    "STROMAUSFALL."
   ],
   "gap_after": 0.32,
   "tag": "shock"
  },
  {
   "text": "Stille.",
   "chunks": [
    "STILLE."
   ],
   "gap_after": 0.32,
   "tag": "shock"
  },
  {
   "text": "Dann flackert die Lampe.",
   "chunks": [
    "DANN FLACKERT",
    "DIE LAMPE."
   ],
   "gap_after": 0.32,
   "tag": "shock"
  },
  {
   "text": "Er steht direkt vor dir.",
   "chunks": [
    "ER STEHT DIREKT",
    "VOR DIR."
   ],
   "gap_after": 0.32,
   "tag": "shock"
  },
  {
   "text": "Sein Kopf knickt zur Seite.",
   "chunks": [
    "SEIN KOPF *KNICKT*",
    "ZUR SEITE."
